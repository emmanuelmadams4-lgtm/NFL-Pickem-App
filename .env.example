# APP_PORT / DB_PORT are optional host-port overrides (defaults 8000 / 5432).
# POSTGRES_PASSWORD must be set and match the password inside DATABASE_URL.
# Copy to .env and fill in. Never commit .env.

# Database (docker compose uses the db service below)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://nflpi:change-me@db:5432/nflpi

# One long random secret. The web app asks for it once.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=

# AI (optional, server-side only)
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=typesafe/jev-1.13
AI_DAILY_CALL_LIMIT=60
AI_RUN_CHECK_DAILY_LIMIT=6

# Alerts (optional, Web Push for the iPhone Home Screen app and browsers).
# Make keys: docker compose exec app python -m nflpi.jobs vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Passkey sign-in (optional). Host name of the app (no scheme) and its https origin(s), comma-separated.
# Leave both empty to keep passkeys off.
PASSKEY_RP_ID=
PASSKEY_ORIGINS=

# Browsers allowed to call the API directly (dev servers). Same-origin needs nothing.
CORS_ORIGINS=http://localhost:3000
ODDS_API_KEY=
ODDS_API_KEY_FALLBACK=
