# Copy to .env and fill in. Never commit .env.

# Database (docker compose uses the db service below)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://nflpi:change-me@db:5432/nflpi

# One long random secret. The web and mobile apps ask for it once.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ACCESS_TOKEN=

# AI (optional, server-side only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=typesafe/jev-1.13
AI_DAILY_CALL_LIMIT=60

# Push (optional). Only needed if you turn on "enhanced push security" in Expo.
EXPO_ACCESS_TOKEN=

# Browsers allowed to call the API directly (dev servers). Same-origin needs nothing.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
