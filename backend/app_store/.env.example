# App Store Settings
# Copy this file to app_store/.env and set required values.

# --- Private API access token (server .env only; change in .env) ---
# Used by the admin UI and Playwright tests to access the API
APP_ACCESS_TOKEN="change-me-in-production-app-access-token"

# --- Web Push (PWA) ---
# Vapid keys are auto-generated at startup if empty, or provide here:
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:emmanuelmadams4@gmail.com"

# --- Passkey sign-in (admin UI) ---
# For local dev, use passkey_rp_id = localhost or the tailscale IP
PASSKEY_RP_ID="localhost"
PASSKEY_ORIGINS="https://localhost,http://localhost"

# --- Admin UI (passkey fallback) ---
ADMIN_PASSWORD=""

# --- Docker / container runtime ---
# Docker socket path; containers default to no network and ALL caps dropped
DOCKER_SOCKET="/var/run/docker.sock"
DOCKER_HOST="unix:///var/run/docker.sock"
DEFAULT_NETWORK="none"
DEFAULT_CAP_DROP="ALL"

# --- Backward compatible: pick'em api access token ---
PICKEM_APP_ACCESS_TOKEN="pickem-api-access-token"
