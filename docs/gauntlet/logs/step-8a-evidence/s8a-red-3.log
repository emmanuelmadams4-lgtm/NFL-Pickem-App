__ test_a_bad_file_fails_the_run_and_keeps_the_old_stars[missing_snap_column] __

session = <sqlalchemy.orm.session.Session object at 0x10a306a50>
case = 'missing_snap_column'

    @pytest.mark.parametrize(
        "case",
        [
            "missing_snap_column",
            "missing_stat_column",
            "negative_snaps",
            "snaps_not_a_number",
            "empty_files",
            "id_too_long",
            "empty_snaps",
            "empty_stats",
            "empty_players",
            "week_out_of_range",
            "blank_team",
            "duplicate_row",
            "stat_too_big",
            "files_end_in_different_weeks",
            "fewer_weeks_than_stored",
            "fewer_clubs_than_stored",
            "snaps_too_many",
            "club_code_too_long",
            "blank_snap_player_id",
            "duplicate_stat_row",
            "stat_not_a_number",
            "stat_infinite",
            "stat_week_out_of_range",
            "long_bad_value",
            "stat_column_all_na",
            "club_missing_from_one_file",
        ],
    )
    def test_a_bad_file_fails_the_run_and_keeps_the_old_stars(session, case):
        ingest(session)
        before = stars(session, 3, "KC")
        snaps, stats, players = handmade()
        if case == "missing_snap_column":
            snaps = _without(snaps, "offense_snaps")
        elif case == "missing_stat_column":
            stats = _without(stats, "def_sacks")
        elif case == "negative_snaps":
            snaps[0] = snaps[0] | {"offense_snaps": "-4"}
        elif case == "snaps_not_a_number":
            snaps[0] = snaps[0] | {"defense_snaps": "lots"}
        elif case == "empty_files":
            snaps, stats = [], []
        elif case == "id_too_long":
            stats[1] = stats[1] | {"player_id": "x" * 40}
        elif case == "empty_snaps":  # a header-only snap file beside a good stats file
            snaps = []
        elif case == "empty_stats":
            stats = []
        elif case == "empty_players":
            players = []
        elif case == "week_out_of_range":  # weeks run 1 to 22
            snaps[0] = snaps[0] | {"week": "23"}
        elif case == "blank_team":
            stats[1] = stats[1] | {"team": " "}
        elif case == "duplicate_row":  # the same player, week and club twice would double his numbers
            snaps.append(snaps[0])
        elif case == "stat_too_big":  # no player gains 5,000 yards in a game
            stats[1] = stats[1] | {"rushing_yards": "5000"}
        elif case == "files_end_in_different_weeks":  # stats stop at week 1, snaps go to week 2
            stats = [r for r in stats if r["week"] == "1"]
        elif case == "fewer_weeks_than_stored":  # an older copy of both files: week 1 only
            snaps = [r for r in snaps if r["week"] == "1"]
            stats = [r for r in stats if r["week"] == "1"]
        elif case == "fewer_clubs_than_stored":  # a cut file: one club is gone
            snaps = [r for r in snaps if r["team"] not in ("LV", "OAK")]
            stats = [r for r in stats if r["team"] != "LV"]
        elif case == "snaps_too_many":  # no player takes more than 300 snaps in a game
            snaps[0] = snaps[0] | {"offense_snaps": "301"}
        elif case == "club_code_too_long":
            snaps[0] = snaps[0] | {"team": "ABCDE"}
        elif case == "blank_snap_player_id":
            snaps[0] = snaps[0] | {"pfr_player_id": " "}
        elif case == "duplicate_stat_row":
            stats.append(stats[1])
        elif case == "stat_not_a_number":
            stats[1] = stats[1] | {"receptions": "many"}
        elif case == "stat_infinite":
            stats[1] = stats[1] | {"def_sacks": "inf"}
        elif case == "stat_week_out_of_range":
            stats[1] = stats[1] | {"week": "0"}
        elif case == "long_bad_value":  # the logged error repeats at most 40 characters of the file
            snaps[0] = snaps[0] | {"defense_snaps": "y" * 300}
        elif case == "stat_column_all_na":  # a column that went missing upstream must not be ranked as zeros
            stats = [r | {"def_safeties": "NA"} for r in stats]
        elif case == "club_missing_from_one_file":  # a cut stats file: the Jets' week 2 rows are gone
            stats = [r for r in stats if not (r["team"] == "NYJ" and r["week"] == "2")]
        run = service.ingest_stars(session, SEASON, snaps=snaps, stats=stats, players=players)
        assert run.status == "failed"
        assert "y" * 41 not in run.error
        assert run.error
        if case.startswith("missing_"):  # the logged error names the file
            assert ("snap_counts" if case == "missing_snap_column" else "stats_player_week") in run.error
        assert stars(session, 3, "KC") == before
