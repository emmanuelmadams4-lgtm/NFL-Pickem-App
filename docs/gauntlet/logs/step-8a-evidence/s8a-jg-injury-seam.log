@api.get("/games/{game_id}", response_model=s.GameDetail)
def game(game_id: str, session: DB) -> s.GameDetail:
    detail = views.game_detail(session, game_id)
    if detail is None:
        raise HTTPException(404, "Game not found")
    return detail


