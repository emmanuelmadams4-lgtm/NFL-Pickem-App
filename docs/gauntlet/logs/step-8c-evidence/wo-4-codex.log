"""Fetch allowlisted feeds with pinned DNS, bounded bodies, and robots checks."""

import ipaddress
import socket
import ssl
import time
import unicodedata
from dataclasses import dataclass
from urllib.parse import urljoin, urlsplit, urlunsplit
from urllib.robotparser import RobotFileParser

import httpx

from nflpi.config import get_settings
from nflpi.ingestion.news.sources import Source

TIMEOUT_S = 10
DEADLINE_S = 20
MAX_FEED_BYTES = 2_000_000
MAX_ROBOTS_BYTES = 512_000
MAX_REDIRECTS = 3
MAX_VALIDATOR_LEN = 256
_NAT64 = (
    ipaddress.ip_network("64:ff9b::/96"),
    ipaddress.ip_network("64:ff9b:1::/48"),
    ipaddress.ip_network("::/96"),
    ipaddress.ip_network("2002::/16"),
    ipaddress.ip_network("2001::/32"),
)
_REDIRECTS = {301, 302, 303, 307, 308}


class FetchError(Exception):
    """A feed could not be fetched safely."""


class Blocked(FetchError):
    """A security or source access rule forbids this fetch."""


@dataclass(frozen=True)
class FetchResult:
    status: int
    body: bytes
    etag: str | None
    last_modified: str | None


def _has_control(value: str) -> bool:
    return any(unicodedata.category(char).startswith("C") for char in value)


def _validator(value: str | None) -> str | None:
    return (
        value
        if isinstance(value, str) and len(value) <= MAX_VALIDATOR_LEN and value.isascii() and value.isprintable()
        else None
    )


def user_agent() -> str:
    base = "NFLPickemIntel/1.0 (private single-user app"
    contact = get_settings().news_contact
    return f"{base}; contact: {contact})" if contact and not _has_control(contact) else f"{base})"


def default_resolver(host: str) -> list[str]:
    addresses: list[str] = []
    for result in socket.getaddrinfo(host, 443, type=socket.SOCK_STREAM):
        address = result[4][0]
        if address not in addresses:
            addresses.append(address)
    return addresses


def build_client(transport: httpx.BaseTransport | None) -> httpx.Client:
    return httpx.Client(transport=transport, trust_env=False, follow_redirects=False, timeout=TIMEOUT_S)


def is_public(address: str) -> bool:
    try:
        ip = ipaddress.ip_address(address)
    except ValueError:
        return False
    if isinstance(ip, ipaddress.IPv6Address):
        if ip.ipv4_mapped:
            ip = ip.ipv4_mapped
        elif any(ip in network for network in _NAT64):
            return False
    return ip.is_global and not ip.is_multicast


def _checked_url(url: str, host: str) -> tuple[str, str]:
    try:
        parts = urlsplit(url)
        hostname = parts.hostname
        valid = (
            parts.scheme.lower() == "https"
            and hostname is not None
            and hostname.lower() == host.lower()
            and parts.username is None
            and parts.password is None
            and parts.port in (None, 443)
            and not _has_control(url)
            and "\\" not in url
        )
    except (ValueError, UnicodeError):
        valid = False
        hostname = None
    if not valid or hostname is None:
        raise Blocked("url blocked")
    return hostname, urlunsplit(("https", hostname, parts.path or "/", parts.query, ""))


def fetch_guarded(
    url: str,
    *,
    host: str,
    resolver=default_resolver,
    transport: httpx.BaseTransport | None = None,
    headers: dict[str, str] | None = None,
    max_bytes: int = MAX_FEED_BYTES,
    content_types: tuple[str, ...] = ("xml",),
    max_redirects: int = MAX_REDIRECTS,
    clock=time.monotonic,
) -> FetchResult:
    start = clock()
    redirects = 0
    with build_client(transport) as client:
        while True:
            if clock() > start + DEADLINE_S:
                raise FetchError("deadline exceeded")
            hostname, hostname_url = _checked_url(url, host)
            try:
                addresses = resolver(hostname)
            except (OSError, UnicodeError) as exc:
                raise FetchError("dns error") from exc
            if not addresses:
                raise FetchError("dns empty")
            if any(not is_public(address) for address in addresses):
                raise Blocked("address blocked")
            if clock() > start + DEADLINE_S:
                raise FetchError("deadline exceeded")
            address = addresses[0]
            ip_host = f"[{address}]" if ":" in address else address
            parts = urlsplit(hostname_url)
            ip_url = urlunsplit(("https", ip_host, parts.path, parts.query, ""))
            request_headers = httpx.Headers(headers or {})
            request_headers["User-Agent"] = user_agent()
            request_headers["Host"] = hostname
            request_headers["Accept-Encoding"] = "identity"
            try:
                with client.stream(
                    "GET", ip_url, headers=request_headers, extensions={"sni_hostname": hostname}
                ) as response:
                    status = response.status_code
                    if status in _REDIRECTS and "location" in response.headers:
                        if redirects >= max_redirects:
                            raise FetchError("too many redirects")
                        location = response.headers["location"]
                        if _has_control(location) or "\\" in location:
                            raise Blocked("url blocked")
                        try:
                            url = urljoin(hostname_url, location)
                        except (ValueError, UnicodeError) as exc:
                            raise Blocked("url blocked") from exc
                        redirects += 1
                        continue
                    if status in (401, 403, 429):
                        raise Blocked(f"status {status}")
                    if status >= 400 and status not in (404, 410):
                        raise FetchError(f"status {status}")
                    if status == 200:
                        media_type = response.headers.get("content-type", "").split(";", 1)[0].lower()
                        if not any(kind in media_type for kind in content_types):
                            raise FetchError("content type")
                    if status in (304, 404, 410):
                        body = b""
                    elif 200 <= status < 300:
                        chunks: list[bytes] = []
                        size = 0
                        for chunk in response.iter_bytes():
                            if clock() > start + DEADLINE_S:
                                raise FetchError("deadline exceeded")
                            size += len(chunk)
                            if size > max_bytes:
                                raise FetchError("too large")
                            chunks.append(chunk)
                        body = b"".join(chunks)
                    else:
                        raise FetchError(f"status {status}")
                    return FetchResult(
                        status,
                        body,
                        _validator(response.headers.get("etag")),
                        _validator(response.headers.get("last-modified")),
                    )
            except (httpx.HTTPError, ssl.SSLError, OSError) as exc:
                raise FetchError(type(exc).__name__) from exc


def check_robots(source: Source, *, resolver=default_resolver, transport: httpx.BaseTransport | None = None) -> None:
    try:
        result = fetch_guarded(
            f"https://{source.host}/robots.txt",
            host=source.host,
            resolver=resolver,
            transport=transport,
            content_types=("text/plain",),
            max_bytes=MAX_ROBOTS_BYTES,
            max_redirects=0,
        )
    except Blocked:
        raise
    except FetchError as exc:
        raise FetchError("robots unavailable") from exc
    if result.status in (404, 410):
        return
    if result.status != 200:
        raise FetchError("robots unavailable")
    parser = RobotFileParser()
    parser.parse(result.body.decode("utf-8", "replace").splitlines())
    if not parser.can_fetch("NFLPickemIntel", source.url):
        raise Blocked("robots disallow")


def fetch_feed(
    source: Source,
    *,
    resolver=default_resolver,
    transport: httpx.BaseTransport | None = None,
    validators: dict[str, str] | None = None,
) -> FetchResult:
    check_robots(source, resolver=resolver, transport=transport)
    conditional: dict[str, str] = {}
    if validators:
        etag = _validator(validators.get("etag"))
        last_modified = _validator(validators.get("last_modified"))
        if etag is not None:
            conditional["If-None-Match"] = etag
"""Poll each news source and record its outcome."""

import logging
from datetime import UTC, datetime, timedelta

from sqlalchemy import select
from sqlalchemy.orm import Session

from nflpi.ingestion.news import fetch, match, parse, sources, store
from nflpi.models import AppSetting, IngestionRun

log = logging.getLogger(__name__)

POLL_MINUTES = 30
BLOCK_HOURS = 24


def run_news(
    session: Session,
    *,
    now: datetime | None = None,
    resolver=None,
    transport=None,
    sources=sources.SOURCES,
) -> list[IngestionRun]:
    now = now if now is not None else datetime.now(UTC)
    resolver = resolver if resolver is not None else fetch.default_resolver
    names = match.load_names(session)
    made: list[IngestionRun] = []
    for src in sources:
        dataset = f"news:{src.id}"
        latest = session.scalars(
            select(IngestionRun)
            .where(IngestionRun.dataset == dataset)
            .order_by(IngestionRun.started_at.desc(), IngestionRun.id.desc())
            .limit(1)
        ).first()
        if latest and (
            latest.started_at > now - timedelta(minutes=POLL_MINUTES)
            or (
                (latest.error or "").startswith("blocked:")
                and latest.started_at > now - timedelta(hours=BLOCK_HOURS)
            )
        ):
            continue

        run = IngestionRun(source=src.id, dataset=dataset, started_at=now, status="running")
        session.add(run)
        session.commit()
        try:
            setting = session.get(AppSetting, f"{dataset}:validators")
            validators = setting.value if setting else None
            result = fetch.fetch_feed(src, resolver=resolver, transport=transport, validators=validators)
            if result.status == 304:
                run.rows = 0
                store.prune(session, now)
            else:
                items = parse.parse_feed(result.body, src, now)
                run.rows = store.store_items(session, src.id, items, names, now)
                if result.etag is not None or result.last_modified is not None:
                    session.merge(
                        AppSetting(
                            key=f"{dataset}:validators",
                            value={"etag": result.etag, "last_modified": result.last_modified},
                        )
                    )
                elif setting is not None:
                    session.delete(setting)
                store.prune(session, now)
            run.status = "ok"
        except fetch.Blocked as exc:
            session.rollback()
            run.status = "failed"
            run.error = parse.clean_text(f"blocked: {exc}", 100)
        except (fetch.FetchError, parse.FeedError) as exc:
            session.rollback()
            log.warning("news %s: %s", src.id, exc)
            run.status = "failed"
            run.error = parse.clean_text(str(exc), 100)
        except Exception as exc:  # noqa: BLE001 - log and continue to the next source
            session.rollback()
            log.exception("news ingestion failed for %s", src.id)
            run.status = "failed"
            run.error = parse.clean_text(f"unexpected: {type(exc).__name__}", 100)
        run.finished_at = datetime.now(UTC)
        session.add(run)
        session.commit()
        made.append(run)
    return made
"""Turn bounded feed bytes into clean, allowlisted news items."""

import io
import unicodedata
from dataclasses import dataclass
from datetime import UTC, datetime, timedelta
from html.parser import HTMLParser
from urllib.parse import quote, unquote_plus, urlsplit, urlunsplit

import feedparser

from nflpi.ingestion.news.sources import Source

_URL_SAFE = "/%:@!$&'()*+,;=-._~?"
_TRACKERS = {"fbclid", "gclid", "ocid"}


class FeedError(Exception):
    """The response is not a usable feed."""


@dataclass(frozen=True)
class Item:
    title: str
    url: str
    published_at: datetime | None
    extract: str


class _Text(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.parts: list[str] = []
        self.hidden = 0

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if tag in ("script", "style"):
            self.hidden += 1

    def handle_endtag(self, tag: str) -> None:
        if tag in ("script", "style") and self.hidden:
            self.hidden -= 1

    def handle_data(self, data: str) -> None:
        if not self.hidden:
            self.parts.append(data)


def clean_text(raw: str, limit: int) -> str:
    parser = _Text()
    parser.feed(raw)
    parser.close()
    text = " ".join("".join(parser.parts).split())
    text = "".join(char for char in text if not unicodedata.category(char).startswith("C"))
    return " ".join(text.split())[:limit].strip()


def canonical_url(link: str | None, suffixes: tuple[str, ...]) -> str | None:
    if not link or any(char.isspace() or unicodedata.category(char).startswith("C") for char in link) or "\\" in link:
        return None
    try:
        parts = urlsplit(link)
        host = parts.hostname
        if host is None:
            return None
        host.encode("ascii")
        if (
            parts.scheme.lower() != "https"
            or parts.username is not None
            or parts.password is not None
            or parts.netloc.lower() != host
            or host.endswith(".")
            or not any(host == suffix or host.endswith("." + suffix) for suffix in suffixes)
        ):
            return None
    except (ValueError, UnicodeError):
        return None
    query_parts = []
    for segment in parts.query.split("&"):
        key = unquote_plus(segment.split("=", 1)[0]).lower()
        if not key.startswith("utm_") and key not in _TRACKERS:
            query_parts.append(segment)
    path = quote(parts.path or "/", safe=_URL_SAFE)
    query = quote("&".join(query_parts), safe=_URL_SAFE)
    result = urlunsplit(("https", host, path, query, ""))
    return result if len(result) <= 2048 else None


def _published(entry: dict, now: datetime) -> datetime | None:
    stamp = entry.get("published_parsed") or entry.get("updated_parsed")
    if not stamp:
        return None
    try:
        published = datetime(*stamp[:6], tzinfo=UTC)
    except (TypeError, ValueError):
        return None
    return None if published > now + timedelta(days=1) else published


def parse_feed(body: bytes, source: Source, now: datetime) -> list[Item]:
    parsed = feedparser.parse(io.BytesIO(body))
    if not parsed.entries and (parsed.bozo or not parsed.get("version")):
        raise FeedError("not a feed")
    items: list[Item] = []
    usable = False
    for entry in parsed.entries[:100]:
        title = clean_text(entry.get("title") or "", 200)
        url = canonical_url(entry.get("link"), source.link_suffixes)
        if not title or not url:
            continue
        usable = True
        published_at = _published(entry, now)
        if published_at is not None and published_at < now - timedelta(days=30):
            continue
        items.append(Item(title, url, published_at, clean_text(entry.get("summary") or "", 300)))
    if parsed.entries and not usable:
        raise FeedError("no usable items")
    return items
"""Store deduplicated news items in step 8f."""

import hashlib
from datetime import datetime, timedelta

from sqlalchemy import delete
from sqlalchemy.dialects.postgresql import insert
from sqlalchemy.orm import Session

from nflpi.ingestion.news import match, parse
from nflpi.models import NewsItem

KEEP_DAYS = 30


def store_items(
    session: Session, source_id: str, items: list[parse.Item], names: match.Names, fetched_at: datetime
) -> int:
    added = 0
    for item in items:
        tied = match.tie(item.title, item.extract, names)
        stmt = insert(NewsItem).values(
            source=source_id,
            title=item.title,
            title_sha256=hashlib.sha256(item.title.encode()).hexdigest(),
            url_canonical=item.url,
            published_at=item.published_at,
            fetched_at=fetched_at,
            extract=item.extract,
            team_ids=tied.team_ids,
            player_ids=tied.player_ids,
            tags=tied.tags,
        ).returning(NewsItem.id)
        if session.execute(stmt.on_conflict_do_nothing()).first() is not None:
            added += 1
    session.commit()
    return added


def prune(session: Session, now: datetime) -> int:
    result = session.execute(delete(NewsItem).where(NewsItem.fetched_at < now - timedelta(days=KEEP_DAYS)))
    session.commit()
    return result.rowcount
"""Tie news items to teams and players in step 8e."""

import re
from collections.abc import Mapping
from dataclasses import dataclass

from sqlalchemy import func, select
from sqlalchemy.orm import Session

from nflpi.ingestion.news.parse import clean_text
from nflpi.models import Team, TeamStar


@dataclass(frozen=True)
class Tie:
    team_ids: list[str]
    player_ids: list[str]
    tags: list[str]


@dataclass(frozen=True)
class Names:
    teams: re.Pattern[str] | None
    team_ids: dict[str, set[str]]
    players: re.Pattern[str] | None
    player_ids: dict[str, str]
    clubs: dict[str, str]


def _pattern(phrases: Mapping[str, object]) -> re.Pattern[str] | None:
    if not phrases:
        return None
    choices = sorted(phrases, key=lambda phrase: (-len(phrase), phrase))
    return re.compile(r"(?<!\w)(?:" + "|".join(re.escape(phrase) for phrase in choices) + r")(?!\w)")


def load_names(session: Session) -> Names:
    team_ids: dict[str, set[str]] = {}
    for abbr, name, nick in session.execute(select(Team.abbr, Team.name, Team.nick)):
        for phrase in (name, nick):
            if phrase:
                team_ids.setdefault(phrase.casefold(), set()).add(abbr)

    season = session.scalar(select(func.max(TeamStar.season)))
    player_ids: dict[str, set[str]] = {}
    latest_clubs: dict[str, tuple[int, str]] = {}
    if season is not None:
        stars = session.execute(
            select(TeamStar.player_id, TeamStar.player, TeamStar.team, TeamStar.week)
            .where(TeamStar.season == season, TeamStar.player_id.is_not(None))
        )
        for player_id, player, team, week in stars:
            phrase = clean_text(player, 64).casefold()
            if phrase:
                player_ids.setdefault(phrase, set()).add(player_id)
            if player_id not in latest_clubs or week > latest_clubs[player_id][0]:
                latest_clubs[player_id] = (week, team)

    unique_players = {phrase: next(iter(ids)) for phrase, ids in player_ids.items() if len(ids) == 1}
    return Names(
        teams=_pattern(team_ids),
        team_ids=team_ids,
        players=_pattern(unique_players),
        player_ids=unique_players,
        clubs={player_id: team for player_id, (_, team) in latest_clubs.items()},
    )


_TAGS = {
    "injury": re.compile(r"\binjur(?:y|ies|ed)\b|\bruled out\b|\bquestionable\b|\bdoubtful\b", re.I),
    "trade": re.compile(r"\btrad(?:e|es|ed|ing)\b", re.I),
    "coach": re.compile(r"\b(?:coach|coaches|coaching|coordinator|fired|fires|firing|hired|hires|hiring)\b", re.I),
    "playcaller": re.compile(r"\bplay[- ]?call(?:er|ers|ing)\b|\bcalling (?:the )?plays\b", re.I),
}


def tie(title: str, extract: str, names: Names) -> Tie:
    text = f"{title} {extract}"
    folded_text = text.casefold()
    teams: set[str] = set()
    players: set[str] = set()
    if names.teams:
        for hit in names.teams.finditer(folded_text):
            teams.update(names.team_ids[hit.group()])
    if names.players:
        for hit in names.players.finditer(folded_text):
            player_id = names.player_ids[hit.group()]
            players.add(player_id)
            teams.add(names.clubs[player_id])
    return Tie(sorted(teams), sorted(players), sorted(tag for tag, pattern in _TAGS.items() if pattern.search(text)))

