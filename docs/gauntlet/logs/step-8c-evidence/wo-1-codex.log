@@ -0,0 +1,17 @@
+"""The fixed list of permitted news feeds."""
+
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class Source:
+    id: str
+    url: str
+    host: str
+    link_suffixes: tuple[str, ...]
