    with pytest.raises(fetch.FetchError):
        fetch.fetch_guarded(
            "https://www.espn.com/feed",
            host="www.espn.com",
            resolver=public_dns,
            transport=httpx.MockTransport(boom),
            content_types=("xml",),
        )


