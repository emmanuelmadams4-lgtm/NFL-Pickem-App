    assert fetch.TIMEOUT_S == 10 and fetch.DEADLINE_S == 20
    assert fetch.MAX_FEED_BYTES == 2_000_000 and fetch.MAX_REDIRECTS == 3
    client = fetch.build_client(None)
    assert client.timeout == httpx.Timeout(10)
    client.close()


